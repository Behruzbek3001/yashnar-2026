{
  "entities": {
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Authorized platform administrator lookup record keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Publicly readable non-PII profile information for district leaderboard display.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "districtName": {
          "type": "string",
          "maxLength": 120
        },
        "mfyName": {
          "type": "string",
          "maxLength": 120
        },
        "leaderboardVisible": {
          "type": "boolean"
        },
        "totalXp": {
          "type": "integer"
        },
        "currentLevel": {
          "type": "integer"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "leaderboardVisible", "updatedAt"]
    },
    "UserPrivateProfile": {
      "title": "UserPrivateProfile",
      "description": "Strictly private user profile containing PII (email, phone, preferences).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "phone": {
          "type": "string",
          "maxLength": 32
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "themePreference": {
          "type": "string",
          "enum": ["light", "dark"],
          "maxLength": 16
        },
        "onboardingCompleted": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "fullName", "themePreference", "onboardingCompleted", "createdAt", "updatedAt"]
    },
    "MfyDirectoryItem": {
      "title": "MfyDirectoryItem",
      "description": "Mahalla (MFY) directory entry within a district.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "districtName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "status": {
          "type": "string",
          "enum": ["approved", "pending", "merged"],
          "maxLength": 24
        },
        "workloadThresholdLiters": {
          "type": "integer"
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "districtName", "name", "status", "workloadThresholdLiters", "createdByUid", "createdAt", "updatedAt"]
    },
    "WasteReport": {
      "title": "WasteReport",
      "description": "Citizen waste collection report tied to a specific MFY and owner UID.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "mfyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "estimatedLiters": {
          "type": "integer"
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "enum": ["submitted", "reviewing", "assigned", "en_route", "arrived", "completed", "cancelled"],
          "maxLength": 24
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerUid", "mfyId", "category", "estimatedLiters", "description", "status", "createdAt", "updatedAt"]
    },
    "EcoFact": {
      "title": "EcoFact",
      "description": "Published daily ecological fact visible to signed-in citizens.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "isActive": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "title", "content", "category", "isActive", "createdAt"]
    },
    "MarketReward": {
      "title": "MarketReward",
      "description": "Eco Market reward catalog item managed exclusively by administrators.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "coinCost": {
          "type": "integer"
        },
        "stockQuantity": {
          "type": "integer"
        },
        "isActive": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "title", "description", "coinCost", "stockQuantity", "isActive", "updatedAt"]
    },
    "UserNotification": {
      "title": "UserNotification",
      "description": "User-scoped notification item under users/{userId}/notifications/{notificationId}.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "isRead": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerUid", "title", "body", "isRead", "createdAt"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Administrator role registry; read/write restricted strictly to verified admins."
    },
    "/users/{userId}/public/profile": {
      "schema": { "$ref": "#/entities/UserPublicProfile" },
      "description": "Public non-PII leaderboard display profile for a user."
    },
    "/users/{userId}/private/info": {
      "schema": { "$ref": "#/entities/UserPrivateProfile" },
      "description": "Owner-only private profile document storing PII (email, phone, preferences)."
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/UserNotification" },
      "description": "Private user notifications gated by parent ownership and admin privileges."
    },
    "/mfys/{mfyId}": {
      "schema": { "$ref": "#/entities/MfyDirectoryItem" },
      "description": "Mahalla (MFY) directory entries; approved entries readable by verified users, mutations validated."
    },
    "/wasteReports/{reportId}": {
      "schema": { "$ref": "#/entities/WasteReport" },
      "description": "Citizen waste collection reports referencing an existing MFY; scoped strictly to owner or admin."
    },
    "/ecoFacts/{factId}": {
      "schema": { "$ref": "#/entities/EcoFact" },
      "description": "Active ecological facts; admin-managed."
    },
    "/marketRewards/{rewardId}": {
      "schema": { "$ref": "#/entities/MarketReward" },
      "description": "Eco Market catalog items; admin-managed."
    }
  }
}
